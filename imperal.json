      },
      "return_schema": {},
      "event": "task.bucket_changed",
      "scopes": [],
      "owner_chat_tool": "tool_tasks_chat"
    },
    {
      "name": "search_vikunja_users",
      "description": "Search for Vikunja users by name or email fragment — use this before assign_task to discover who is available, or when the user asks who they can assign tasks to. Pass empty query to list all known users on the Vikunja instance.",
      "action_type": "read",
      "chain_callable": false,
