      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "update:task"
      ],
      "id_projection": "task_id",
      "params_schema": {
        "properties": {
          "task_id": {
            "description": "Integer task ID. Never UUID.",
            "title": "Task Id",
            "type": "integer"
          },
          "priority": {
            "description": "0=none, 1=low, 2=medium, 3=high, 4=urgent, 5=critical.",
