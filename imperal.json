      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "update:task"
      ],
      "id_projection": "task_id",
      "params_schema": {
        "properties": {
          "task_id": {
            "description": "Integer task ID. Never UUID.",
            "title": "Task Id",
