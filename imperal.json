{
  "manifest_schema_version": 3,
  "sdk_version": "4.2.10",
  "app_id": "tasks",
  "version": "3.9.3",
  "name": "Tasks",
  "description": "Kanban task manager connecting to your own Vikunja instance — create, assign, filter tasks and manage projects and labels.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "tasks:read",
    "tasks:write"
  ],
  "tools": [
    {
      "name": "tool_tasks_chat",
      "description": "Tasks manager — kanban boards, projects, due dates, labels, assignees, comments. Each user connects their own Vikunja instance; data lives in the user's Vikunja, never on our side. When invoking this tool, pass the user's request verbatim as `message`; the extension dispatches to typed @chat.function handlers.",
      "scopes": [],
      "parameters": {
        "message": {
          "type": "string",
          "required": false
        },
        "kwargs": {
          "type": "string",
          "required": true
        }
      }
    },
    {
      "name": "skeleton_refresh_tasks",
      "description": "Background: today/overdue/upcoming counts + recent tasks + active projects.",
      "scopes": [],
      "parameters": {}
    },
    {
      "name": "skeleton_alert_tasks",
      "description": "Alert on new overdue tasks or today's task count changes.",
      "scopes": [],
      "parameters": {
        "old": {
          "type": "string",
          "required": false
        },
        "new": {
          "type": "string",
          "required": false
        }
      }
    },
    {
      "name": "connect_vikunja",
      "description": "Connect a user's Vikunja instance via username + password. The password is forwarded to the backend service once, exchanged for a long-lived Personal Access Token, and discarded. Only the encrypted PAT is stored. Returns base_url + username on success.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "create:connection"
      ],
      "id_projection": "",
      "params_schema": {
        "description": "Connect via username + password (default flow).",
        "properties": {
          "base_url": {
            "default": "",
            "description": "Your Vikunja base URL, e.g. https://vikunja.example.com",
            "title": "Base Url",
            "type": "string"
          },
          "username": {
            "default": "",
            "description": "Your Vikunja username.",
            "title": "Username",
            "type": "string"
          },
          "password": {
            "default": "",
            "description": "Your Vikunja password (used once to mint a long-lived API token, never stored).",
            "title": "Password",
            "type": "string"
          }
        },
        "title": "ConnectVikunjaParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "connection.created",
      "scopes": [],
      "owner_chat_tool": "tool_tasks_chat"
    },
    {
      "name": "connect_vikunja_with_pat",
      "description": "Advanced connect: user pastes a pre-existing Vikunja Personal Access Token (Settings → API tokens in their Vikunja UI). The PAT is encrypted on bridge and stored at rest.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "create:connection"
      ],
      "id_projection": "",
      "params_schema": {
        "description": "Advanced: user pastes a pre-existing PAT minted in their Vikunja UI.",
        "properties": {
          "base_url": {
            "default": "",
            "title": "Base Url",
            "type": "string"
          },
          "pat": {
            "default": "",
            "description": "Vikunja Personal Access Token (Settings → API tokens).",
            "title": "Pat",
            "type": "string"
          }
        },
        "title": "ConnectVikunjaWithPatParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "connection.created",
      "scopes": [],
      "owner_chat_tool": "tool_tasks_chat"
    },
    {
      "name": "disconnect_vikunja",
      "description": "Disconnect from the user's Vikunja: revoke the stored API token in their instance and delete the local connection record.",
      "action_type": "destructive",
      "chain_callable": true,
      "effects": [
        "delete:connection"
      ],
      "id_projection": "",
      "params_schema": {
        "description": "Empty Pydantic params model for no-arg @chat.function handlers (V17 compliance).",
        "properties": {},
        "title": "NoParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "connection.deleted",
      "scopes": [],
      "owner_chat_tool": "tool_tasks_chat"
    },
    {
      "name": "get_connection_status",
      "description": "Check whether the user has a Vikunja connected (read-only — never echoes the API token). Returns connected: bool plus base_url and username when connected.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "description": "Empty Pydantic params model for no-arg @chat.function handlers (V17 compliance).",
        "properties": {},
        "title": "NoParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "",
      "scopes": [],
      "owner_chat_tool": "tool_tasks_chat"
    },
    {
      "name": "create_task",
      "description": "Create a new task in a project. Returns task_id + full task details.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "create:task"
      ],
      "id_projection": "project_id",
      "params_schema": {
        "properties": {
          "project_id": {
            "description": "Project (board) to create task in.",
            "title": "Project Id",
            "type": "integer"
          },
          "title": {
            "description": "Task title.",
            "maxLength": 250,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "description": {
            "default": "",
            "description": "Optional description, markdown.",
            "title": "Description",
            "type": "string"
          },
          "due_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "ISO 8601 due date (e.g. 2026-04-25T12:00:00Z).",
            "title": "Due Date"
          },
          "priority": {
            "anyOf": [
              {
                "maximum": 5,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "0=none, 5=urgent.",
            "title": "Priority"
          },
          "bucket_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Kanban bucket; default = first bucket of project.",
            "title": "Bucket Id"
          }
        },
        "required": [
          "project_id",
          "title"
        ],
        "title": "CreateTaskParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "task.created",
      "scopes": [],
      "owner_chat_tool": "tool_tasks_chat"
    },
    {
      "name": "update_task",
      "description": "Update any fields of a task (title, description, due_date, priority, percent_done, bucket, etc.).",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "update:task"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "task_id": {
            "title": "Task Id",
            "type": "integer"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Description"
          },
          "due_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Due Date"
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start Date"
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "End Date"
          },
          "priority": {
            "anyOf": [
              {
                "maximum": 5,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Priority"
          },
          "percent_done": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Percent Done"
          },
          "bucket_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Bucket Id"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Move to another project.",
            "title": "Project Id"
          },
          "hex_color": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Hex Color"
          }
        },
        "required": [
          "task_id"
        ],
        "title": "UpdateTaskParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "task.updated",
      "scopes": [],
      "owner_chat_tool": "tool_tasks_chat"
    },
    {
      "name": "complete_task",
      "description": "Mark a task as done (done=true, percent_done=1.0).",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "update:task"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "task_id": {
            "title": "Task Id",
            "type": "integer"
          }
        },
        "required": [
          "task_id"
        ],
        "title": "CompleteTaskParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "task.completed",
      "scopes": [],
      "owner_chat_tool": "tool_tasks_chat"
    },
    {
      "name": "uncomplete_task",
      "description": "Reopen a task — mark it as not done (done=false, percent_done=0). Inverse of complete_task.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "update:task"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "task_id": {
            "description": "Integer task ID. Never UUID.",
            "title": "Task Id",
            "type": "integer"
          }
        },
        "required": [
          "task_id"
        ],
        "title": "UncompleteTaskParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "task.uncompleted",
      "scopes": [],
      "owner_chat_tool": "tool_tasks_chat"
    },
    {
      "name": "delete_task",
      "description": "Permanently delete a task. Cannot be undone.",
      "action_type": "destructive",
      "chain_callable": true,
      "effects": [
        "delete:task"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "task_id": {
            "title": "Task Id",
            "type": "integer"
          }
        },
        "required": [
          "task_id"
        ],
        "title": "DeleteTaskParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "task.deleted",
      "scopes": [],
      "owner_chat_tool": "tool_tasks_chat"
    },
    {
      "name": "create_subtask",
      "description": "Create a subtask under a parent task. Returns the new subtask's task_id.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "create:task"
      ],
      "id_projection": "parent_task_id",
      "params_schema": {
        "properties": {
          "parent_task_id": {
            "description": "ID of the parent task.",
            "title": "Parent Task Id",
            "type": "integer"
          },
          "title": {
            "description": "Subtask title.",
            "maxLength": 250,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "description": {
            "default": "",
            "description": "Optional description.",
            "title": "Description",
            "type": "string"
          }
        },
        "required": [
          "parent_task_id",
          "title"
        ],
        "title": "CreateSubtaskParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "task.created",
      "scopes": [],
      "owner_chat_tool": "tool_tasks_chat"
    },
    {
      "name": "list_subtasks",
      "description": "List all subtasks of a given task, including their done/pending status.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "task_id": {
            "description": "Parent task ID to list subtasks for.",
            "title": "Task Id",
            "type": "integer"
          }
        },
        "required": [
          "task_id"
        ],
        "title": "ListSubtasksParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "",
      "scopes": [],
      "owner_chat_tool": "tool_tasks_chat"
    },
    {
      "name": "toggle_checklist_item",
      "description": "Check or uncheck a TipTap checklist item in a task description. Use item_index (0-based) from the visible checklist order.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "update:task"
      ],
      "id_projection": "task_id",
      "params_schema": {
        "properties": {
          "task_id": {
            "description": "Task whose description checklist to update.",
            "title": "Task Id",
            "type": "integer"
          },
          "item_index": {
            "description": "Zero-based index of the checklist item.",
            "minimum": 0,
            "title": "Item Index",
            "type": "integer"
          },
          "checked": {
            "description": "True to mark done, False to uncheck.",
            "title": "Checked",
            "type": "boolean"
          }
        },
        "required": [
          "task_id",
          "item_index",
          "checked"
        ],
        "title": "ToggleChecklistItemParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "task.updated",
      "scopes": [],
      "owner_chat_tool": "tool_tasks_chat"
    },
    {
      "name": "assign_task",
      "description": "Assign a person to a task by their name or email address (e.g. 'Val' or 'val@webhostmost.com'). The bridge resolves the name/email to a Vikunja user ID automatically — never ask for a numeric ID.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "update:task"
      ],
      "id_projection": "task_id",
      "params_schema": {
        "properties": {
          "task_id": {
            "default": 0,
            "description": "Integer task ID. Pass 0 if you only know the task by name — task_name will be used to auto-resolve it.",
            "title": "Task Id",
            "type": "integer"
          },
          "task_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Task title to search for when task_id is unknown. The first matching task is used — prefer find_task first for disambiguation.",
            "title": "Task Name"
          },
          "assignee_query": {
            "description": "Name or email of the person to assign (e.g. 'Val', 'val@webhostmost.com'). The bridge resolves it to a Vikunja user ID automatically.",
            "title": "Assignee Query",
            "type": "string"
          }
        },
        "required": [
          "assignee_query"
        ],
        "title": "AssignTaskParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "task.assigned",
      "scopes": [],
      "owner_chat_tool": "tool_tasks_chat"
    },
    {
      "name": "unassign_task",
      "description": "Remove a Vikunja user (by integer user ID) from a task's assignee list.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "update:task"
      ],
      "id_projection": "task_id",
      "params_schema": {
        "properties": {
          "task_id": {
            "description": "Integer task ID. Never UUID.",
            "title": "Task Id",
            "type": "integer"
          },
          "assignee_vikunja_user_id": {
            "description": "Integer Vikunja user ID (same one used in assign_task).",
            "title": "Assignee Vikunja User Id",
            "type": "integer"
          }
        },
        "required": [
          "task_id",
          "assignee_vikunja_user_id"
        ],
        "title": "UnassignTaskParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "task.unassigned",
      "scopes": [],
      "owner_chat_tool": "tool_tasks_chat"
    },
    {
      "name": "add_label",
      "description": "Attach an existing label (by integer label_id) to a task (by integer task_id). If you only know the label name, call create_label or ask the user for the numeric label_id — Vikunja addresses labels by ID, never by name.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "update:task"
      ],
      "id_projection": "task_id",
      "params_schema": {
        "properties": {
          "task_id": {
            "description": "Integer task ID. Never UUID.",
            "title": "Task Id",
            "type": "integer"
          },
          "label_id": {
            "description": "Integer label ID — obtain via create_label response or Vikunja UI. Never label name.",
            "title": "Label Id",
            "type": "integer"
          }
        },
        "required": [
          "task_id",
          "label_id"
        ],
        "title": "AddLabelParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "task.labeled",
      "scopes": [],
      "owner_chat_tool": "tool_tasks_chat"
    },
    {
      "name": "remove_label",
      "description": "Detach a label (by integer label_id) from a task (by integer task_id).",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "update:task"
      ],
      "id_projection": "task_id",
      "params_schema": {
        "properties": {
          "task_id": {
            "description": "Integer task ID. Never UUID.",
            "title": "Task Id",
            "type": "integer"
          },
          "label_id": {
            "description": "Integer label ID currently attached to this task.",
            "title": "Label Id",
            "type": "integer"
          }
        },
        "required": [
          "task_id",
          "label_id"
        ],
        "title": "DetachLabelParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "task.unlabeled",
      "scopes": [],
      "owner_chat_tool": "tool_tasks_chat"
    },
    {
      "name": "set_due_date",
      "description": "Set or change due date of a task. Pass integer task_id and due_date as ISO 8601 UTC string (e.g. '2026-04-25T12:00:00Z'). Convert relative dates ('Friday', 'tomorrow') in user's timezone first.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "update:task"
      ],
      "id_projection": "task_id",
      "params_schema": {
        "properties": {
          "task_id": {
            "description": "Integer task ID. Never UUID.",
            "title": "Task Id",
            "type": "integer"
          },
          "due_date": {
            "description": "ISO 8601 UTC string, e.g. '2026-04-25T12:00:00Z'.",
            "title": "Due Date",
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "due_date"
        ],
        "title": "SetDueDateParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "task.due_changed",
      "scopes": [],
      "owner_chat_tool": "tool_tasks_chat"
    },
    {
      "name": "set_priority",
